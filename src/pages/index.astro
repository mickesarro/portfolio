---
import Layout from '../layouts/Layout.astro';
import { getCollection, getEntry, render } from 'astro:content';

// Fetch the About section
const aboutEntry = await getEntry('pages', 'about');
// Use the new Astro 5 render function
const { Content: AboutContent } = aboutEntry ? await render(aboutEntry) : { Content: () => null };

// Fetch projects and sort them by the 'order' field
const projects = await getCollection('projects');
const sortedProjects = projects.sort((a, b) => a.data.order - b.data.order);
---

<Layout>
  <!-- Who Am I Section -->
  <section class="markdown-body">
    {aboutEntry && <AboutContent />}
  </section>

  <hr style="margin: 3rem 0; border-color: var(--border);" />

  <!-- Projects Sequential List -->
  <section>
    <h2 style="font-size: 2rem; margin-bottom: 2rem;">Projects</h2>
    
    <div style="display: flex; flex-direction: column; gap: 3rem;">
      {sortedProjects.map(async (project) => {
        const { Content } = await render(project);
        return (
          <article style="background: var(--card-bg); padding: 2rem; border-radius: 8px; border: 1px solid var(--border);">
            <header style="margin-bottom: 1rem;">
              <div style="display: flex; align-items: baseline; gap: 1rem; margin-bottom: 0.5rem;">
                <h3 style="margin: 0; font-size: 1.5rem; color: var(--accent);">
                  {project.data.title}
                </h3>
                
                {project.data.links && project.data.links.length > 0 && (
                  <div style="display: flex; gap: 0.5rem; font-size: 0.9rem;">
                    {project.data.links.map(link => (
                      <a href={link.url} target="_blank" style="color: var(--text-muted); text-decoration: none;">
                        [{link.name}]
                      </a>
                    ))}
                  </div>
                )}
              </div>
              
              {project.data.tags && (
                <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
                  {project.data.tags.map(tag => (
                    <span style="background: rgba(255,255,255,0.1); padding: 0.1rem 0.5rem; border-radius: 99px; font-size: 0.8rem;">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </header>

            {project.data.image && (
              <img src={project.data.image} alt={project.data.title} style="max-width: 100%; border-radius: 6px; margin-bottom: 1rem;" />
            )}

            <p style="margin: 0 0 1rem 0;">{project.data.description}</p>

            <button class="read-more-btn" aria-expanded="false">
              <span class="icon">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="6 9 12 15 18 9"></polyline>
                </svg>
              </span>
              <span class="text">Read more</span>
            </button>

            <div class="expandable-wrapper">
              <div class="expandable-inner">
                <div class="markdown-body" style="padding-top: 1rem; margin-top: 1rem; border-top: 1px solid var(--border);">
                  <Content />
                </div>
              </div>
            </div>

          </article>
        )
      })}
    </div>
  </section>
</Layout>

<style>
  .read-more-btn {
    background: none;
    border: none;
    color: var(--accent);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    padding: 0;
    font-family: inherit;
  }
  
  .read-more-btn .icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--accent);
    transition: transform 0.3s ease;
  }
  
  .read-more-btn[aria-expanded="true"] .icon {
    transform: rotate(180deg);
  }

  /* Seamless CSS Grid expansion */
  .expandable-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease-out;
  }
  
  .expandable-wrapper.is-open {
    grid-template-rows: 1fr;
  }
  
  .expandable-inner {
    overflow: hidden;
  }
</style>

<script>
  const buttons = document.querySelectorAll('.read-more-btn');
  
  buttons.forEach(button => {
    button.addEventListener('click', () => {
      const article = button.closest('article');
      const wrapper = article.querySelector('.expandable-wrapper');
      const textSpan = button.querySelector('.text');
      
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      
      if (isExpanded) {
        wrapper.classList.remove('is-open');
        button.setAttribute('aria-expanded', 'false');
        textSpan.textContent = 'Read more';
      } else {
        wrapper.classList.add('is-open');
        button.setAttribute('aria-expanded', 'true');
        textSpan.textContent = 'Read less';
      }
    });
  });
</script>