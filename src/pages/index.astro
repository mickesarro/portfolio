---
import { getCollection } from 'astro:content';
const projects = await getCollection('projects');
---

<html lang="en">
  <head>
    <title>My Portfolio</title>
  </head>
  <body class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold mb-6">Selected Projects</h1>
    <div class="grid gap-6">
      {projects.map((project) => (
        <article class="p-6 border rounded-lg">
          <h2 class="text-xl font-semibold">{project.data.title}</h2>
          <p class="text-gray-600 mt-2">{project.data.description}</p>
          {project.data.link && (
            <a href={project.data.link} class="text-blue-500 hover:underline mt-4 inline-block">
              View Project →
            </a>
          )}
        </article>
      ))}
    </div>
  </body>
</html>